# Gemini API Key — Required
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Live API model. Verify with: npm run list-models (must support bidiGenerateContent).
# Candidate to evaluate: gemini-3.8-live (UNVERIFIED by official docs; confirm via list-models)
GEMINI_LIVE_MODEL=

# AUDIO (native-audio models; needs output transcription) or TEXT (half-cascade models)
GEMINI_RESPONSE_MODALITY=AUDIO

# Backend server port (default: 3001)
PORT=3001

# Frontend URL for CORS (set in production)
# FRONTEND_URL=https://your-app.web.app

# Vite frontend: backend URL (if not using the default proxy)
# VITE_BACKEND_URL=http://localhost:3001
